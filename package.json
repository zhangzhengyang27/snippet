{
  "name": "snippet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@vueuse/core": "^11.0.0",
    "axios": "^1.7.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.13",
    "material-symbols": "^0.45.10",
    "monaco-editor": "^0.52.0",
    "pinia": "^2.2.0",
    "vditor": "^3.11.3",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "vuedraggable": "^4.1.0",
    "xiaoye-ui": "6.1.0",
    "@iconify/vue": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/diff": "^8.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.41",
    "dayjs": "^1.11.22",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.28.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.5.0",
    "shiki": "^1.22.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.1.10"
  },
  "pnpm": {
    "patchedDependencies": {
      "xiaoye-ui": "patches/xiaoye-ui.patch"
    }
  }
}