  if (lang === 'css' && !/\{/.test(trimmed)) mismatch.push('css-no-block')
  if (lang === 'sql' && !/\b(select|insert|update|delete|create|alter|drop|with|grant|pragma)\b/i.test(trimmed))
    mismatch.push('sql-no-kw')
  if (mismatch.length) issues.push({ kind: 'lang_mismatch', severity: 'medium', detail: mismatch })

  // 8. 行尾 / 控制字符（\x1b ANSI 转义是终端脚本正常内容，排除）
  if (/\r\n/.test(code)) issues.push({ kind: 'crlf', severity: 'low', detail: null })
  if (hasControlChar(code)) issues.push({ kind: 'control_chars', severity: 'high', detail: null })

  // 9. JS 顶层语法检查（vm 编译，import/export/顶层 await 属模块语法跳过）
  if (lang === 'javascript' && trimmed.length > 30) {
    const err = tryJsCompile(trimmed)
    if (err) issues.push({ kind: 'js_syntax', severity: 'high', detail: err })
