  }

  // 备份
  const ts = new Date().toISOString().replace(/[:.]/g, '-')
  const backupFile = `backup_code_quality_fix_${ts}.json`
  const backupJson = psql(`SELECT COALESCE(json_agg(row_to_json(t)), '[]'::json) FROM ui_knowledge_snippets t`)
  fs.writeFileSync(path.join(__dirname, backupFile), backupJson)
  console.log(`备份写入 scripts/${backupFile}`)

  // 写库：仅对发生变化的列生成 UPDATE
