const BASE = process.env.API_TARGET || 'http://localhost:3000'
const ENDPOINT = '/api/knowledge/snippets'
const OUT = 'scripts/html-split-report.json'

async function main() {
  let all = []
  let page = 1
  while (true) {
    const res = await fetch(`${BASE}${ENDPOINT}?page=${page}&pageSize=100`)
    if (!res.ok) {
      console.error('请求失败', res.status)
      process.exit(1)
    }
    const data = await res.json()
    const items = data.items || []
    all = all.concat(items)
    const total = data.total ?? data.count ?? all.length
    if (items.length === 0 || all.length >= total) break
    page++
  }
  const SCRIPT_RE = /<script\b[^>]*?\bsrc=["']([^"']+)["'][^>]*>/gi
  const LINK_RE = /<link\b[^>]*?\bhref=["']([^"']+)["'][^>]*>/gi
  const htmlSnippets = all.filter(
    (s) => s.language === 'html' || /<html[\s>]/i.test(s.content || '')
  )
  const report = []
  for (const s of htmlSnippets) {
    const content = s.content || ''
    const files = (s.displayAttrs && s.displayAttrs.files) || []
    const fileNames = new Set(files.map((f) => f.name))
    const refs = []
    let m
    while ((m = SCRIPT_RE.exec(content))) refs.push({ type: 'script', src: m[1] })
    while ((m = LINK_RE.exec(content))) {
      if (/stylesheet/i.test(m[0])) refs.push({ type: 'css', src: m[1] })
    }
    const external = refs.filter((r) => !/^(https?:|data:|#)/i.test(r.src))
    if (external.length === 0) continue
    const missing = []
    for (const r of external) {
      const name = r.src.replace(/[?#].*$/, '').replace(/^\.\//, '')
      if (!fileNames.has(name) && !fileNames.has('./' + name) && !fileNames.has(r.src))
        missing.push(r.src)
    }
    const hasRealServerRef = external.some(
      (r) =>
        /^\/(socket\.io|static|assets|dist)\b/.test(r.src) ||
        /chunk\.[a-f0-9]+\.css|chunk\.[a-f0-9]+\.js/.test(r.src) ||
        /^\.\.\//.test(r.src)
    )
    let category
    if (hasRealServerRef) category = 'C-外部资源(不可离线修复)'
    else if (missing.length === 0) category = 'OK-引用齐全'
    else if (files.length === 0) category = 'A-数据缺失(files为空)'
    else category = 'B/D-可内联但files缺内容'
    const fixable = category === 'OK-引用齐全' || category.startsWith('B/D')
    report.push({
      id: s.id,
      name: s.name,
      category,
      fixable,
      refCount: external.length,
      missingCount: missing.length,
      refs: external.map((r) => r.src),
      fileCount: files.length,
      fileNames: [...fileNames],
    })
  }
  const sorted = report.sort((a, b) => a.category.localeCompare(b.category))
  const summary = {
    totalScanned: all.length,
    htmlTotal: htmlSnippets.length,
    splitTotal: sorted.length,
    byCategory: sorted.reduce((acc, r) => {
      acc[r.category] = (acc[r.category] || 0) + 1
      return acc
    }, {}),
    fixableCount: sorted.filter((r) => r.fixable).length,
    brokenCount: sorted.filter((r) => !r.fixable && r.category !== 'OK-引用齐全').length,
  }

